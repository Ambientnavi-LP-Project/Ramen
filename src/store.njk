<!-- ============ (予約促進ダイアログは削除) ============ -->

<script>
  // ナビのスクロール検出
  (function(){
    var nav = document.querySelector('.lp-nav');
    if (!nav) return;
    function onScroll(){
      if (window.scrollY > 60) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    }
    window.addEventListener('scroll', onScroll, {passive:true});
    onScroll();
  })();

  // ヒーロースライドショー（画像4枚）
  (function(){
    var slideshow = document.getElementById('heroSlideshow');
    if (!slideshow) return;
    var slides = slideshow.querySelectorAll('.hero__slide');
    if (slides.length < 2) return;
    var current = 0;
    // タイミング: 各画像 5.5秒
    var INTERVAL = 5500;
    function next(){
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
      setTimeout(next, INTERVAL);
    }
    setTimeout(next, INTERVAL);
  })();

  // Sticky live activity
  (function(){
    var v = document.getElementById('sticky-viewing');
    var r = document.getElementById('sticky-reserved');
    function setV(){
      if (!v) return;
      v.textContent = 5 + Math.floor(Math.random() * 5);
    }
    function setR(){
      if (!r) return;
      var stored = parseInt(sessionStorage.getItem('{{ store.slug }}-reserved'), 10);
      if (!stored || isNaN(stored) || stored < 11 || stored > 17) {
        stored = 11 + Math.floor(Math.random() * 7);
        sessionStorage.setItem('{{ store.slug }}-reserved', stored);
      }
      if (Math.random() < 0.4 && stored < 17) {
        stored += 1;
        sessionStorage.setItem('{{ store.slug }}-reserved', stored);
      }
      r.textContent = stored;
    }
    setV();
    setR();
    setInterval(setV, 180000);
    setInterval(setR, 9000000);
  })();

</script>

<script>
  /* === クリック計測（data-ga-event → dataLayer → GTM → GA4）===
     計測したい要素に data-ga-event="イベント名" を付けるだけ。
     店舗・チャネル等のパラメータはコード側で組み立てず、GTM側でURLから解決する。 */
  window.dataLayer = window.dataLayer || [];
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-ga-event]');
    if (!el) return;
    window.dataLayer.push({
      event: el.getAttribute('data-ga-event'),
      event_label: (el.getAttribute('data-ga-location') || ''),
      store_name: '{{ store.slug }}',
      store_area: '{{ store.region }}',
      brand: 'ramen',
      channel: 'default'
    });
  }, true);
</script>

<!-- ACQ-FORWARD: 本当の獲得元(utm/gclid)をTableCheck予約リンクへ転記。TableCheck側のクロスドメイン受入待ちの代替。 -->
<script>
(function(){
  var KEYS=['utm_source','utm_medium','utm_campaign','utm_term','gclid','gbraid','wbraid'];
  try{var qs=new URLSearchParams(location.search);KEYS.forEach(function(k){var v=qs.get(k);if(v&&!sessionStorage.getItem('acq_'+k))sessionStorage.setItem('acq_'+k,v);});}catch(e){}
  function extra(){var p=[];KEYS.forEach(function(k){var v=null;try{v=sessionStorage.getItem('acq_'+k);}catch(e){}if(v)p.push(encodeURIComponent(k)+'='+encodeURIComponent(v));});return p.join('&');}
  function one(a){if(!a||a.getAttribute('data-acq'))return;var h=a.getAttribute('href');if(!h||h.indexOf('tablecheck.com')<0)return;var e=extra();if(!e)return;a.setAttribute('href',h+(h.indexOf('?')>-1?'&':'?')+e);a.setAttribute('data-acq','1');}
  function all(){var l=document.querySelectorAll('a[href*="tablecheck.com"]');for(var i=0;i<l.length;i++)one(l[i]);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',all);else all();
  document.addEventListener('click',function(e){var a=e.target.closest?e.target.closest('a[href*="tablecheck.com"]'):null;if(a)one(a);},true);
})();
</script>
</body>
</html>
